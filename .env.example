# ==============================================================================
# PingGuard Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Credentials & Configuration
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(24))"
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-generate-a-random-one
POSTGRES_DB=pingguard

# --- For Docker Compose (Container-to-Container via Docker DNS) ---
DATABASE_URL=postgresql+asyncpg://postgres:change-me-generate-a-random-one@db:5432/pingguard

# --- For Local Bare-Metal Development (Host-to-Localhost) ---
# DATABASE_URL=postgresql+asyncpg://postgres:change-me-generate-a-random-one@localhost:5432/pingguard

# --- For Running Automated Tests Safely (Port 55432 or dedicated _test DB) ---
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:testpass@localhost:55432/pingguard_test

# ------------------------------------------------------------------------------
# 2. Redis Broker & Backend Configuration
# ------------------------------------------------------------------------------
# --- For Docker Compose (Container-to-Container via Docker DNS) ---
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND_URL=redis://redis:6379/1

# --- For Local Bare-Metal Development (Host-to-Localhost) ---
# REDIS_BROKER_URL=redis://localhost:6379/0
# REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 3. Celery Beat Periodic Sweep Frequency & Batching
# ------------------------------------------------------------------------------
SWEEP_INTERVAL_SECONDS=15.0
SWEEP_BATCH_SIZE=500
SWEEP_MAX_BATCHES=20

# ------------------------------------------------------------------------------
# 4. Network Resilience & HTTPX Prober Settings
# ------------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT=2.0
HTTP_READ_TIMEOUT=5.0
HTTP_WRITE_TIMEOUT=5.0
HTTP_POOL_TIMEOUT=2.0
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=PingGuard-Monitor/1.0.0 (+https://github.com/AmanYdv77/pingguard; uptime-engine)

# ------------------------------------------------------------------------------
# 5. Security & Authentication Settings
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 24 characters and cannot be a default placeholder.
# ------------------------------------------------------------------------------
API_KEY=change-me-generate-a-random-one

# ------------------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of permitted frontend origins (no paths, wildcards rejected).
# Leave empty or omit to disable CORS headers entirely.
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 7. Rate Limiting & Resource Limits
# ------------------------------------------------------------------------------
RATE_LIMIT_WRITES_PER_MINUTE=60
MAX_MONITORS=100

# ------------------------------------------------------------------------------
# 8. Data Retention & Maintenance Settings
# ------------------------------------------------------------------------------
PING_RESULTS_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=10000
